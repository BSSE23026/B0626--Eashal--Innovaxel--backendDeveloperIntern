    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('event_id', jsonData.id);",
                  "  pm.test('Event created successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(jsonData.name).to.equal('Tech Conference 2024');",
                  "    pm.expect(jsonData.available_seats).to.equal(100);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech Conference 2024\",\n  \"total_seats\": 100,\n  \"event_date\": \"2024-12-15T10:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Create a new event with name, total seats, and date"
          },
          "response": []
        },
