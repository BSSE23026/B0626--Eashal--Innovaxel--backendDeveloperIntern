            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"event_id\": {{event_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/registrations",
              "host": ["{{base_url}}"],
