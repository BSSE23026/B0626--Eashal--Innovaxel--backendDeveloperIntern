    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register User - User 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('registration_id_1', jsonData.id);",
                  "  pm.test('User registered successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(jsonData.username).to.equal('alice');",
                  "    pm.expect(jsonData.is_active).to.equal(1);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
