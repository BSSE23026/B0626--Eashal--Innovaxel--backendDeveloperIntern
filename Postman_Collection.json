    {
      "name": "Concurrent Testing",
      "item": [
        {
          "name": "Setup - Create Limited Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('limited_event_id', jsonData.id);",
                  "  pm.test('Limited event created', function () {",
                  "    pm.expect(jsonData.total_seats).to.equal(2);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Limited Capacity Event {{$timestamp}}\",\n  \"total_seats\": 2,\n  \"event_date\": \"2024-12-30T15:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Create event with only 2 seats for concurrent testing"
          },
          "response": []
        },
        {
          "name": "Concurrent - Register User 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"concurrent_user_1\",\n  \"event_id\": {{limited_event_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/registrations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "registrations"]
            },
            "description": "Register first user for limited event"
          },
          "response": []
        },
        {
          "name": "Concurrent - Register User 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"concurrent_user_2\",\n  \"event_id\": {{limited_event_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/registrations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "registrations"]
            },
            "description": "Register second user for limited event (event now full)"
          },
          "response": []
        },
        {
          "name": "Concurrent - Register User 3 (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"concurrent_user_3\",\n  \"event_id\": {{limited_event_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/registrations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "registrations"]
            },
            "description": "Try to register third user when event is full (should return 409)"
          },
          "response": []
        }
